{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Onigiri Editor",
  "version": "1.3.0",
  "identifier": "app.onigiri.markdown",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Onigiri Editor",
        "width": 1360,
        "height": 860,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: https://asset.localhost; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://asset.localhost http: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* https:; frame-src 'self' http: https: blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mdx"],
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": ["txt", "php", "phtml", "html", "css", "js", "jsx", "ts", "tsx", "json", "yaml", "yml", "py", "rs", "sql", "sh"],
        "name": "Source & Text Document",
        "role": "Editor"
      }
    ]
  }
}
